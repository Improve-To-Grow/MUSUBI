{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "musubi-code index --hook",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "musubi-code index --hook",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "musubi-code hint --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "musubi-code hint --hook",
            "if": "Bash(grep *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "musubi-code hint --hook",
            "if": "Bash(rg *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "musubi-code hint --hook",
            "if": "Bash(git grep *)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "musubi-code hint --hook",
            "if": "PowerShell(Select-String *)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
